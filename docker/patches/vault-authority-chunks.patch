+func loadChunkedAuthority(ctx context.Context, storage logical.Storage, manifest authorityChunkManifest) (*authorityState, error) {
+	generationBytes, generationErr := hex.DecodeString(manifest.Generation)
+	if generationErr != nil || len(generationBytes) != 16 || manifest.PayloadSize <= 0 || manifest.PayloadSize > maxAuthorityPayloadSize || len(manifest.PayloadSHA256) != 64 {
