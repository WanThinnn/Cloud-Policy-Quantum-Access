+package abe
+
+import (
+    "context"
+    "github.com/hashicorp/vault/sdk/framework"
+    "github.com/hashicorp/vault/sdk/logical"
+)
+
+// Public authority inspection never creates or rotates keys, and never exports MSK/signing secrets.
+func pathAuthority(b *abeBackend) *framework.Path {
+    return &framework.Path{
+        Pattern: "authority",
+        Operations: map[logical.Operation]framework.OperationHandler{
+            logical.ReadOperation: &framework.PathOperation{Callback: b.pathAuthorityRead},
+        },
+        HelpSynopsis: "Read public authority metadata without changing keys.",
+    }
+}
+
+func (b *abeBackend) pathAuthorityRead(ctx context.Context, req *logical.Request, _ *framework.FieldData) (*logical.Response, error) {
+    b.authorityMu.RLock()
+    defer b.authorityMu.RUnlock()
+    state, err := loadAuthority(ctx, req.Storage)
+    if err != nil { return nil, err }
+    if state == nil || len(state.MSK) == 0 { return nil, nil }
+    return state.publicResponse(), nil
+}
