+package abe
+
+import (
+    "context"
+    "crypto/sha256"
+    "fmt"
+    "strings"
+    "testing"
+    "github.com/hashicorp/vault/sdk/logical"
+)
+
+func TestPublicAuthorityRecoveryDoesNotReplaceKeys(t *testing.T) {
+    b, storage := newTestBackend(t)
+    state := &authorityState{Format: 1, Scheme: "covercrypt", Revision: 7,
+        PK: []byte("public-fixture"), MSK: []byte("master-fixture"),
+        PQCPublic: []byte("verify-fixture"), PQCSecret: []byte("sign-fixture")}
+    if err := saveAuthority(context.Background(), storage, state); err != nil { t.Fatal(err) }
+    before, _ := storage.Get(context.Background(), authorityKey)
+    response, err := b.HandleRequest(context.Background(), &logical.Request{
+        Operation: logical.ReadOperation, Path: "authority", Storage: storage,
+    })
+    if err != nil || response == nil || response.IsError() { t.Fatalf("authority read failed: %v", err) }
+    expected := fmt.Sprintf("vault-authority-sha256:%x", sha256.Sum256(state.PK))
+    if response.Data["public_key"] != expected { t.Fatal("incorrect public key reference") }
+    for _, key := range []string{"msk", "master_key", "secret_key", "pqc_private_key"} {
+        if _, found := response.Data[key]; found { t.Fatal("public response exposed secret field") }
+    }
+    after, _ := storage.Get(context.Background(), authorityKey)
+    if string(before.Value) != string(after.Value) { t.Fatal("authority read modified stored keys") }
+    denied := request(t, b, storage, "encrypt", map[string]interface{}{
+        "scheme":"covercrypt", "plaintext":"aGVsbG8=", "policy":"Department::IT",
+        "public_key":"vault-authority-sha256:" + strings.Repeat("0",64),
+    }, true)
+    if !strings.Contains(denied["error"].(string), "reference differs") { t.Fatal("wrong keyset not rejected") }
+}
